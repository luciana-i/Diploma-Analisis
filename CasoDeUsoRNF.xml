        <properties type="Requirements" name="Diagrama de Requerimientos No Funcionales"/>
        <project author="Sagrado Corazón" version="1.0" created="2026-08-18" modified="2026-08-18"/>
        <elements>
          <element subject="EAID_RNF01" seqno="1" style="DUID=RNF1;"/>
          <element subject="EAID_RNF02" seqno="2" style="DUID=RNF2;"/>
          <element subject="EAID_RNF03" seqno="3" style="DUID=RNF3;"/>
          <element subject="EAID_RNF04" seqno="4" style="DUID=RNF4;"/>
          <element subject="EAID_RNF05" seqno="5" style="DUID=RNF5;"/>
        </elements>
      </diagram>
    </diagrams>
  </xmi:Extension>
